{
	"name": "sveltekit-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node --experimental-strip-types --import ./config/otel/init.ts node_modules/vite/bin/vite.js dev",
		"build": "prisma generate && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && husky",
		"postinstall": "prisma generate",
		"check": "prisma generate && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"lint:oxlint": "oxlint",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:unit": "vitest run src/tests/unit",
		"test:integration": "vitest run src/tests/integration",
		"test:components": "vitest run src/tests/components",
		"db:push": "prisma db push",
		"db:migrate": "prisma migrate dev",
		"db:studio": "prisma studio",
		"db:generate": "prisma generate",
		"db:seed": "node scripts/seed-projects.js",
		"db:seed:bio": "node scripts/seed-bio.js",
		"assets:og": "node scripts/generate-og.mjs",
		"assets:project-images": "node scripts/optimize-project-images.mjs",
		"test:e2e": "playwright test",
		"semgrep:scan": "semgrep scan --config p/ci --config p/typescript --config p/nodejs --config config/semgrep/rules --metrics off",
		"otel:verify": "node scripts/test-otlp.mjs",
		"fallow": "fallow"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@fontsource/inter": "^5.2.5",
		"@fontsource/manrope": "^5.2.5",
		"@oxlint/plugins": "^1.79.0",
		"@playwright/test": "^1.61.0",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^25",
		"@types/sanitize-html": "^2.16.1",
		"@vitest/coverage-v8": "^4.1.9",
		"esbuild": "^0.28.1",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.7.0",
		"happy-dom": "^20.10.6",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.7",
		"oxlint": "^1.79.0",
		"prettier": "3.8.4",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"prisma": "^7.9.1",
		"sharp": "^0.35.2",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.1",
		"tailwindcss": "^4.0.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.0",
		"vite": "^8.1.0",
		"vitest": "^4.1.9"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/auto-instrumentations-node": "^0.79.0",
		"@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
		"@opentelemetry/resources": "^2.10.0",
		"@opentelemetry/sdk-metrics": "^2.10.0",
		"@opentelemetry/sdk-node": "^0.221.0",
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"dotenv": "^17.4.2",
		"pg": "^8.16.0",
		"sanitize-html": "^2.17.5",
		"sveltekit-superforms": "^2.30.1",
		"zod": "^4.3.6"
	},
	"overrides": {
		"cookie": "^0.7.2",
		"brace-expansion@2": "2.1.4",
		"brace-expansion@5": "5.0.9",
		"deepmerge-ts": ">=8.0.0",
		"fast-uri": ">=3.1.5",
		"joi": ">=18.2.1",
		"nanoid@3": "3.3.18",
		"postcss": ">=8.5.26",
		"protobufjs": ">=7.6.5",
		"tar": ">=7.5.22",
		"ts-deepmerge": ">=8.0.0",
		"@sveltejs/adapter-vercel": {
			"esbuild": "^0.28.1"
		}
	},
	"engines": {
		"node": "22.x"
	},
	"lint-staged": {
		"*.{ts,js,svelte}": [
			"prettier --check",
			"eslint --max-warnings 0 --no-warn-ignored"
		],
		"*.{css,json,md,yml}": [
			"prettier --check"
		]
	}
}
